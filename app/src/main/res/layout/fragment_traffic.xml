<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Traffic capture / Cloud monitoring" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pasivni sledovani odchozich spojeni kamery (proc/net)" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTraffic" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Zachytavat"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopTraffic" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Zastavit" app:backgroundTint="#F44336"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Traffic stats -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Celkem TX" android:textSize="11sp"/>
                <TextView android:id="@+id/tvTxBytes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Celkem RX" android:textSize="11sp"/>
                <TextView android:id="@+id/tvRxBytes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Konexe" android:textSize="11sp"/>
                <TextView android:id="@+id/tvConnectionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tabulka spojeni -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="8dp" android:text="Aktivni spojeni" android:textStyle="bold"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConnections" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:padding="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cloud endpoints -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" app:cardElevation="2dp"
        app:cardBackgroundColor="#0D1B2A">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Cloud endpoints (kam kamera odesila data)" android:textStyle="bold"
                android:textColor="#4FC3F7"/>
            <TextView android:id="@+id/tvCloudEndpoints" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="--"
                android:textSize="11sp" android:fontFamily="monospace"
                android:textColor="#81D4FA"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
