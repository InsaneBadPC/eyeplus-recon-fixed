<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" app:cardElevation="2dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvResultsSummary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Spust rekognoskaci v zalozce RECON"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:padding="12dp"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportJson" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="JSON"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportMd" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Markdown"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAll" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Kopirovat" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
</LinearLayout>
